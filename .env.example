# =============================================================
# LTT PLATFORM - ENVIRONMENT VARIABLES EXAMPLE
# =============================================================
# انسخ هذا الملف إلى .env وعدل القيم
# cp .env.example .env
# =============================================================

# ---- Vercel Deployment ----
# VITE_ متغيرات تبدأ بـ تنتقل تلقائياً إلى Frontend
VITE_API_URL=/api

# ---- Database (Neon PostgreSQL - Serverless) ----
# احصل على الرابط من https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/ltt_platform?sslmode=require

# ---- Authentication ----
SESSION_SECRET=your-session-secret-at-least-32-characters-long
TOKEN_EXPIRY=24h

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:20147

# ---- File Uploads ----
MAX_FILE_SIZE=10485760

# ---- Security ----
NODE_ENV=production
LOG_LEVEL=info

# ---- Seed Data ----
DEFAULT_PASSWORD=LTT@2024
