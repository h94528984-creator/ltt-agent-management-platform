# =============================================================
# LTT PLATFORM - ENVIRONMENT VARIABLES (Cloudflare + Development)
# =============================================================
# انسخ هذا الملف إلى .env للتطوير المحلي
# cp .env.example .env
# =============================================================

# ---- Vite (Frontend) ----
# القيمة الافتراضية "/api" تعمل مع Cloudflare Pages Functions
VITE_API_URL=/api

# ---- Database (Neon PostgreSQL - Serverless) ----
# ⚠️ لا تضع الرابط هنا مباشرة. استخدم Cloudflare Dashboard
# DATABASE_URL=postgresql://user:password@ep-example.aws.neon.tech/neondb?sslmode=require

# ---- Authentication ----
SESSION_SECRET=your-session-secret-at-least-32-characters-long
TOKEN_EXPIRY=24h

# ---- Security ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Seed Data ----
DEFAULT_PASSWORD=LTT@2024
