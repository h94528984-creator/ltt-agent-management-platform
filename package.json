{
  "name": "workspace",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "private": true,
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs'); for (const f of ['package-lock.json','yarn.lock']) fs.rmSync(f,{force:true}); if (!String(process.env.npm_config_user_agent||'').startsWith('pnpm/')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "build": "corepack pnpm run build:cloudflare",
    "build:cloudflare": "corepack pnpm --filter @workspace/ltt-platform run build",
    "typecheck": "corepack pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "corepack pnpm --filter @workspace/ltt-platform run dev",
    "dev:form": "corepack pnpm --filter @workspace/agent-request-form run dev",
    "db:push": "corepack pnpm --filter @workspace/db run push",
    "db:generate": "corepack pnpm --filter @workspace/db run generate",
    "db:migrate": "corepack pnpm --filter @workspace/db run migrate",
    "db:studio": "corepack pnpm --filter @workspace/db run studio",
    "codegen": "corepack pnpm --filter @workspace/api-spec run codegen",
    "clean:dist": "if (Test-Path artifacts/ltt-platform/dist) { Remove-Item -Recurse -Force artifacts/ltt-platform/dist }"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
