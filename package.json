{
  "name": "workspace",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run build:cloudflare",
    "build:cloudflare": "pnpm --filter @workspace/ltt-platform run build",
    "typecheck": "pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "pnpm --filter @workspace/ltt-platform run dev",
    "dev:form": "pnpm --filter @workspace/agent-request-form run dev",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "db:studio": "pnpm --filter @workspace/db run studio",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "clean:dist": "if (Test-Path artifacts/ltt-platform/dist) { Remove-Item -Recurse -Force artifacts/ltt-platform/dist }"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
